# Defaults work from the repository root; no secrets are required.
TRIPGENIE_LOG_LEVEL=INFO
TRIPGENIE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRIPGENIE_DATA_PATH=/absolute/path/to/data/processed/india_tourism_processed.json

# Production WSGI bind (used by backend/gunicorn.conf.py)
TRIPGENIE_BIND=127.0.0.1:5001
